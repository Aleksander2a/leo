# Runtime
LEO_ENV=development
LEO_LOG_LEVEL=INFO
# Initial live-eval candidate; change only if the recorded fixture comparison warrants it.
LEO_MODEL=deepseek/deepseek-v4-flash-0731
LEO_MAX_MODEL_TURNS=12
LEO_MAX_TOOL_CALLS=24
LEO_MAX_RUN_SECONDS=600
LEO_MAX_OUTPUT_TOKENS=2000

# Slack Socket Mode
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional read-only history identity for conversations.replies across public,
# private, and shared threads. Reinstall user OAuth after adding history scopes.
SLACK_USER_TOKEN=
LEO_SLACK_TEAM_ID=
LEO_ORGANIZATION_ID=demo-org
LEO_STRATEGY_ID=technology-ls

# OpenRouter raw API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hosted Supabase Postgres connection string
# Use direct or session-pooler (5432) TLS URL, not transaction mode. Never commit a real value.
DATABASE_URL=

# Finnhub docs: https://finnhub.io/docs/api/
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Tavily docs: https://docs.tavily.com/documentation/api-reference/endpoint/search
# Optional public-web discovery. Search output must be fetched before source citation.
TAVILY_API_KEY=
# Optional MCP transport endpoint; native REST never consumes this secret value.
TAVILY_ENDPOINT=
TAVILY_MAX_CALLS_PER_MINUTE=10
# Worst-case safe for the 1,000-credit free tier (advanced search costs 2 credits).
TAVILY_MAX_CALLS_PER_MONTH=500

# Exa canonical coding-agent guide:
# https://exa.ai/docs/reference/search-api-guide-for-coding-agents
# Optional Exa raw Search. Uses one URL-bound highlights mode; no Exa Agent framework.
EXA_API_KEY=

# Optional provider-neutral equity market redundancy. These integrations use direct,
# typed REST calls only; no provider agent framework is installed.
# Alpha Vantage docs: https://www.alphavantage.co/documentation/
# ALPHA_VANTAGE_ENDPOINT and _LEGACY may remain MCP URLs. Leo only treats an endpoint
# as REST when it is exactly https://www.alphavantage.co/query; otherwise REST stays
# pinned to that fixed official URL. The conservative free-tier allowance is 25/day.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_ENDPOINT=
ALPHA_VANTAGE_ENDPOINT_LEGACY=
ALPHA_VANTAGE_MAX_CALLS_PER_MINUTE=5
ALPHA_VANTAGE_MAX_CALLS_PER_DAY=25

# Massive docs: https://www.massive.com/docs/ai-tools/quickstart
# MASSIVE_ENDPOINT may remain an MCP URL. Native REST stays pinned to
# https://api.massive.com; snapshot entitlement depends on the configured Stocks plan.
MASSIVE_API_KEY=
MASSIVE_ENDPOINT=
MASSIVE_MAX_CALLS_PER_MINUTE=10

# TickerLayer docs: https://tickerlayer.com/docs
# Native REST is fixed to https://api.tickerlayer.com. Fundamentals requires a
# separate permission; the free REST allowance is 3,000 calls per UTC month.
TICKER_LAYER_API_KEY=
TICKER_LAYER_MAX_CALLS_PER_MINUTE=60
TICKER_LAYER_MAX_CALLS_PER_MONTH=3000

EQUITY_QUOTE_AGREEMENT_THRESHOLD_PERCENT=1
EQUITY_QUOTE_MAX_CORROBORATION_SKEW_SECONDS=900

# CoinGecko REST docs: https://docs.coingecko.com/reference/coins-markets
# CoinMarketCap REST docs:
# https://coinmarketcap.com/api/documentation/pro-api-reference/cryptocurrency
# Optional cryptocurrency market-data redundancy. COINGECKO_ENDPOINT is retained
# for a separately configured MCP transport; Leo's native adapter uses the REST base.
COINGECKO_ENDPOINT=
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_MAX_CALLS_PER_MINUTE=20
COIN_MARKET_CAP_API_KEY=
COIN_MARKET_CAP_BASE_URL=https://pro-api.coinmarketcap.com
COIN_MARKET_CAP_MAX_CALLS_PER_MINUTE=20
CRYPTO_AGREEMENT_THRESHOLD_BPS=250
CRYPTO_MAX_CORROBORATION_SKEW_SECONDS=120

# Optional primary-source adapter. SEC asks clients to identify an operator contact.
SEC_USER_AGENT=
SEC_EDGAR_BASE_URL=https://data.sec.gov/submissions
